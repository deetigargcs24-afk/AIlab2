
#include <iostream>
using namespace std;

const int MAX = 20;

int graph[MAX][MAX];
bool found = false;

bool DLS(int node, int goal, int depth) {

    cout << node << " ";

    if (node == goal) {
        found = true;
        return true;
    }

    if (depth == 0)
        return false;

    for (int i = 0; i < MAX; i++) {
        if (graph[node][i] == 1) {

            if (DLS(i, goal, depth - 1))
                return true;
        }
    }

    return false;
}

void IDS(int start, int goal, int maxDepth) {

    for (int depth = 0; depth <= maxDepth; depth++) {

        cout << "\nDepth Limit " << depth << ": ";

        if (DLS(start, goal, depth)) {
            cout << "\nGoal Found!";
            return;
        }
    }

    cout << "\nGoal not found!";
}

int main() {

    int n, edges;
    int u, v;
    int start, goal, maxDepth;

    cout << "Enter number of nodes: ";
    cin >> n;

    cout << "Enter number of edges: ";
    cin >> edges;

    cout << "Enter edges:\n";

    for (int i = 0; i < edges; i++) {
        cin >> u >> v;
        graph[u][v] = 1;
    }

    cout << "Enter start node: ";
    cin >> start;

    cout << "Enter goal node: ";
    cin >> goal;

    cout << "Enter maximum depth: ";
    cin >> maxDepth;

    IDS(start, goal, maxDepth);

    return 0;
}
