
#include <iostream>
using namespace std;

int main() {
    bool P, Q, R;
    bool KB;
    bool query;
    bool entails = true;

    cout << "Knowledge Base:\n";
    cout << "1. P -> Q\n";
    cout << "2. P\n";
    cout << "3. Q -> R\n";

    cout << "\nQuery: R\n";

    cout << "\nTruth Table:\n";
    cout << "P Q R | KB | Query\n";

    for (int i = 0; i < 8; i++) {

        P = (i & 4) != 0;
        Q = (i & 2) != 0;
        R = (i & 1) != 0;

        // Construct Knowledge Base
        KB = ((!P || Q) && P && (!Q || R));

        // Query
        query = R;

        cout << P << " "
             << Q << " "
             << R << " | "
             << KB << "  | "
             << query << endl;

        // Check entailment
        if (KB && !query) {
            entails = false;
        }
    }

    cout << "\nResult:\n";

    if (entails)
        cout << "KB entails the Query.";
    else
        cout << "KB does NOT entail the Query.";

    return 0;
}
