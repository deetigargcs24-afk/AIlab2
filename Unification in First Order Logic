
#include <iostream>
#include <vector>
#include <string>
using namespace std;

bool isVariable(string s) {
    return !s.empty() && islower(s[0]);
}

bool unify(string a, string b,
           vector<pair<string, string>>& subs) {

    if (a == b)
        return true;

    // If a is a variable
    if (isVariable(a)) {
        subs.push_back({a, b});
        return true;
    }

    // If b is a variable
    if (isVariable(b)) {
        subs.push_back({b, a});
        return true;
    }

    return false;
}

int main() {

    string p1, p2;
    int n;

    cout << "Enter first predicate name: ";
    cin >> p1;

    cout << "Enter second predicate name: ";
    cin >> p2;

    if (p1 != p2) {
        cout << "Unification not possible!";
        return 0;
    }

    cout << "Enter number of arguments: ";
    cin >> n;

    vector<string> a(n), b(n);

    cout << "Enter arguments of first predicate:\n";
    for (int i = 0; i < n; i++)
        cin >> a[i];

    cout << "Enter arguments of second predicate:\n";
    for (int i = 0; i < n; i++)
        cin >> b[i];

    vector<pair<string, string>> subs;

    for (int i = 0; i < n; i++) {

        if (!unify(a[i], b[i], subs)) {
            cout << "\nUnification failed!";
            return 0;
        }
    }

    cout << "\nUnification Successful!";
    cout << "\nMost General Unifier (MGU):\n";

    if (subs.empty()) {
        cout << "No substitution required.";
    } else {
        for (auto s : subs)
            cout << s.first << " = " << s.second << endl;
    }

    return 0;
}

