
#include <iostream>
using namespace std;

int main() {
    int A, B;
    int position = 0;  // 0 = A, 1 = B

    cout << "Enter status of Room A (0=Clean, 1=Dirty): ";
    cin >> A;

    cout << "Enter status of Room B (0=Clean, 1=Dirty): ";
    cin >> B;

    cout << "\nVacuum Cleaner Agent Started\n";

    while (A == 1 || B == 1) {

        if (position == 0) {
            cout << "\nVacuum is in Room A";

            if (A == 1) {
                cout << "\nRoom A is Dirty. Cleaning...";
                A = 0;
            } else {
                cout << "\nRoom A is Clean. Moving to Room B.";
                position = 1;
            }
        }

        else {
            cout << "\nVacuum is in Room B";

            if (B == 1) {
                cout << "\nRoom B is Dirty. Cleaning...";
                B = 0;
            } else {
                cout << "\nRoom B is Clean. Moving to Room A.";
                position = 0;
            }
        }
    }

    cout << "\n\nBoth rooms are clean!";
    cout << "\nFinal Status:";
    cout << "\nRoom A: Clean";
    cout << "\nRoom B: Clean";

    return 0;
}
